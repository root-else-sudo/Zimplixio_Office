generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(REVIEWER)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  REVIEWER
}

// ─── Rate Limits ─────────────────────────────────────────────────────────────

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ─── Departments — the org chart ─────────────────────────────────────────────

enum DepartmentKey {
  PRODUCT_RESEARCH
  ENGINEERING
  MARKETING
  SALES
  FINANCE
  OPERATIONS
}

enum DepartmentStatus {
  BUILT
  RESERVED
}

model Department {
  id        String           @id @default(cuid())
  key       DepartmentKey    @unique
  name      String
  purpose   String
  status    DepartmentStatus @default(RESERVED)
  order     Int              @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  goals     Goal[]
  tasks     Task[]
  knowledge Knowledge[]
  kpis      Kpi[]
}

// ─── Shared Department Anatomy ────────────────────────────────────────────────

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

model Goal {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tasks Task[]

  @@index([departmentId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([goalId])
}

// Starter operating context per department (planning §1.3). One row per seeded bullet.
model Knowledge {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  content      String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

// Basic KPI definitions per department (planning §1.3). Definitions only — no
// computed/tracked value yet; that is future work once real activity exists to measure.
model Kpi {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}
