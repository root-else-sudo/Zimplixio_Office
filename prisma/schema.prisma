generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(REVIEWER)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]
  pushSubs      PushSubscription[]
}

enum Role {
  ADMIN
  REVIEWER
}

// ─── Agents ──────────────────────────────────────────────────────────────────

model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String
  cronSchedule String
  scriptPath   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs PipelineRun[]
}

// ─── Pipeline Runs ───────────────────────────────────────────────────────────

model PipelineRun {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id])
  status          RunStatus @default(RUNNING)
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  // Deprecated since Phase 4 — structured per-step events live in PipelineEvent.
  // Kept so historical rows remain readable; new rows leave this null.
  log             String?
  // Optional dedup key (e.g. source-email-hash). Phase 4 reserves the column;
  // production population lands in Phase 5's audit work.
  idempotencyKey  String?   @unique

  posts  Post[]
  events PipelineEvent[]
}

model PipelineEvent {
  id        String   @id @default(cuid())
  runId     String
  run       PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepName  String
  // started | stdout | stderr | finished | failed
  eventType String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([eventType])
}

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ─── Posts ───────────────────────────────────────────────────────────────────

model Post {
  id            String     @id @default(cuid())
  runId         String
  run           PipelineRun @relation(fields: [runId], references: [id])
  newsletter    String
  sourceSubject String
  sourceDate    DateTime
  content       String
  status        PostStatus @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum PostStatus {
  DRAFT
  APPROVED
  REJECTED
  PUBLISHED
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Business Opportunities ──────────────────────────────────────────────────

model Opportunity {
  id             String   @id @default(cuid())
  title          String
  sector         String
  signal         String
  zimplixioAngle String
  actions        Json
  generatedAt    DateTime @default(now())
}

// ─── Push Subscriptions ──────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─── Rate Limits ─────────────────────────────────────────────────────────────

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ─── LLM Telemetry ───────────────────────────────────────────────────────────

model LlmCall {
  id                  String   @id @default(cuid())
  userId              String?
  route               String
  model               String
  inputTokens         Int      @default(0)
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  outputTokens        Int      @default(0)
  latencyMs           Int      @default(0)
  costUsd             Decimal? @db.Decimal(12, 6)
  success             Boolean  @default(true)
  errorCode           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([route])
  @@index([model])
}
