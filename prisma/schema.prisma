generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(REVIEWER)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  REVIEWER
}

// ─── Rate Limits ─────────────────────────────────────────────────────────────

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ─── Departments — the org chart ─────────────────────────────────────────────

enum DepartmentKey {
  PRODUCT_RESEARCH
  ENGINEERING
  MARKETING
  SALES
  FINANCE
  OPERATIONS
}

enum DepartmentStatus {
  BUILT
  RESERVED
}

model Department {
  id        String           @id @default(cuid())
  key       DepartmentKey    @unique
  name      String
  purpose   String
  status    DepartmentStatus @default(RESERVED)
  order     Int              @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  goals           Goal[]
  tasks           Task[]
  knowledge       Knowledge[]
  kpis            Kpi[]
  companyProfile  CompanyProfile?
  guidanceSummary GuidanceSummary?
  findings        Finding[]
  probeRuns       ProbeRun[]
}

// ─── Shared Department Anatomy ────────────────────────────────────────────────

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

model Goal {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tasks Task[]

  @@index([departmentId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([goalId])
}

// Starter operating context per department (planning §1.3). One row per seeded bullet.
model Knowledge {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  content      String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

// Basic KPI definitions per department (planning §1.3). Definitions only — no
// computed/tracked value yet; that is future work once real activity exists to measure.
model Kpi {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

// ─── Product/Research — department-specific artifacts (planning §2) ──────────

// The agent's fit lens (planning §2.1): freeform prose describing what
// Zimplixio can credibly offer. Singleton per department (only
// Product/Research has one so far).
model CompanyProfile {
  id           String     @id @default(cuid())
  departmentId String     @unique
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// The second grounding input (planning §2.3): a plain-English distillation of
// past validate/reject decisions, rewritten (not appended) each learning
// cycle so it stays bounded. Owner-editable, same as CompanyProfile — an
// edit's updatedAt becomes the new "already learned from this" watermark the
// engine uses to find newly-reviewed Findings on the next run.
model GuidanceSummary {
  id           String     @id @default(cuid())
  departmentId String     @unique
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  content      String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum FindingStatus {
  CANDIDATE
  VALIDATED
  REJECTED
}

// A candidate service opportunity (planning §2.2). No fit rationale -> not a
// valid Finding, per the doc, but that's enforced at the form/API layer, not
// the schema, since Zod validation is the injection/shape boundary here.
model Finding {
  id              String        @id @default(cuid())
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title           String
  evidence        String
  fitRationale    String
  status          FindingStatus @default(CANDIDATE)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([departmentId])
  @@index([status])
}

// ─── Research Probe (POC — fully isolated from the Research Engine above) ────

model ProbeRun {
  id           String         @id @default(cuid())
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  companyName  String
  manualNotes  String?
  status       ProbeRunStatus @default(RUNNING)
  errorMessage String?
  costUsd      Float?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  signalItems ProbeSignalItem[]
  hypotheses  ProbeHypothesis[]

  @@index([departmentId])
}

enum ProbeRunStatus {
  RUNNING
  COMPLETE
  FAILED
}

model ProbeSignalItem {
  id        String            @id @default(cuid())
  runId     String
  run       ProbeRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  source    ProbeSignalSource
  title     String?
  url       String?
  content   String
  createdAt DateTime          @default(now())

  @@index([runId])
}

enum ProbeSignalSource {
  MANUAL
  TAVILY_SEARCH
  TAVILY_EXTRACT
  EXTRACT_FAILED
}

model ProbeHypothesis {
  id                    String           @id @default(cuid())
  runId                 String
  run                   ProbeRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  need                  String
  proposedService       String
  basedOnSignal         String[]
  title                 String?
  evidence              String?
  fitRationale          String?
  confidence            ProbeConfidence?
  disconfirmingEvidence String?
  createdAt             DateTime         @default(now())

  @@index([runId])
}

enum ProbeConfidence {
  LOW
  MEDIUM
  HIGH
}
